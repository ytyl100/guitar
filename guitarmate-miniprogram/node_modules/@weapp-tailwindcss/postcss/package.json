{
  "name": "@weapp-tailwindcss/postcss",
  "type": "module",
  "version": "3.3.8",
  "description": "PostCSS transforms that bring Tailwind CSS compatibility to every platform. 将 Tailwind CSS 兼容能力带到全端的 PostCSS 转换工具。",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/weapp-tailwindcss.git",
    "directory": "packages/postcss"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/weapp-tailwindcss/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./html-transform": {
      "types": "./dist/html-transform.d.ts",
      "import": "./dist/html-transform.js",
      "require": "./dist/html-transform.cjs"
    },
    "./css-macro/postcss": {
      "types": "./dist/css-macro/postcss.d.ts",
      "import": "./dist/css-macro/postcss.js",
      "require": "./dist/css-macro/postcss.cjs"
    },
    "./package.json": "./package.json",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./experimental/lightningcss": {
      "types": "./dist/experimental/lightningcss/index.d.ts",
      "import": "./dist/experimental/lightningcss/index.js",
      "require": "./dist/experimental/lightningcss/index.cjs"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js",
      "require": "./dist/syntax.cjs"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "import": "./dist/transform.js",
      "require": "./dist/transform.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "html-transform": [
        "./dist/html-transform.d.ts"
      ],
      "css-macro/postcss": [
        "./dist/css-macro/postcss.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ],
      "native": [
        "./dist/native.d.ts"
      ],
      "experimental/lightningcss": [
        "./dist/experimental/lightningcss/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "lightningcss": "^1.33.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@csstools/css-color-parser": "^4.2.3",
    "@csstools/css-parser-algorithms": "^4.0.0",
    "@csstools/css-tokenizer": "^4.0.1",
    "@weapp-core/escape": "~8.0.0",
    "@weapp-tailwindcss/engine": "0.1.1",
    "@weapp-tailwindcss/postcss-calc": "1.0.8",
    "@weapp-tailwindcss/shared": "2.0.3",
    "@weapp-tailwindcss/source-scan": "0.1.1",
    "autoprefixer": "^10.6.1",
    "es-toolkit": "^1.52.0",
    "lru-cache": "11.5.3",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^11.5.3",
    "postcss-pxtrans": "^1.0.5",
    "postcss-rem-to-responsive-pixel": "^7.0.6",
    "postcss-rule-unit-converter": "^0.2.4",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss-config": "2.0.5"
  },
  "devDependencies": {
    "@csstools/postcss-is-pseudo-class": "^6.0.0",
    "fast-check": "^4.10.2",
    "lightningcss": "^1.33.0",
    "postcss-custom-properties": "^15.0.1",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown && tsc -p tsconfig.build.json && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts .",
    "build:types": "tsc -p tsconfig.build.json && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts .",
    "test": "vitest run",
    "bench": "vitest bench",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  }
}