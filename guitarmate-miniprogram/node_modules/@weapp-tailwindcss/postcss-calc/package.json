{
  "name": "@weapp-tailwindcss/postcss-calc",
  "version": "1.0.8",
  "type": "module",
  "description": "PostCSS calc reduction utility for cross-platform Tailwind CSS builds. 跨端 Tailwind CSS 构建使用的 PostCSS calc 归约工具。",
  "keywords": [
    "css",
    "postcss",
    "postcss-plugin",
    "calculation",
    "calc"
  ],
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/weapp-tailwindcss.git",
    "directory": "packages/postcss-calc"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/weapp-tailwindcss/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "author": "Andy Jansson",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jison-gho": "0.6.1-216",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "~5.0.1"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "postcss": "^8.4.38"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "jison ./parser.jison -o src/parser.cjs && tsdown",
    "build:parser": "jison ./parser.jison -o src/parser.cjs",
    "build:types": "tsdown --dts-only",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "publish-packages": "pnpm publish"
  }
}