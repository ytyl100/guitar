{
  "name": "weapp-tailwindcss",
  "type": "module",
  "version": "5.5.9",
  "description": "Bring Tailwind CSS to every platform! 把 Tailwind CSS 的原子化开发体验带到全端！",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://tw.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/weapp-tailwindcss.git",
    "directory": "packages/weapp-tailwindcss"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/weapp-tailwindcss/issues"
  },
  "keywords": [
    "tailwindcss",
    "weapp",
    "wechat",
    "mini",
    "miniprogram",
    "mini app",
    "weapp-tw",
    "weapp-tailwindcss",
    "taro",
    "uni-app",
    "remax",
    "mpx",
    "jit",
    "mp",
    "android",
    "ios",
    "小程序",
    "vite",
    "postcss",
    "webpack",
    "webpack-plugin",
    "gulp",
    "gulp-plugin"
  ],
  "exports": {
    ".": {
      "style": "./index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./escape": {
      "types": "./dist/escape.d.ts",
      "import": "./dist/escape.js",
      "require": "./dist/escape.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./vite/web": {
      "types": "./dist/vite/web.d.ts",
      "import": "./dist/vite/web.js",
      "require": "./dist/vite/web.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "require": "./dist/rspack.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./gulp": {
      "types": "./dist/gulp.d.ts",
      "import": "./dist/gulp.js",
      "require": "./dist/gulp.cjs"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js",
      "require": "./dist/generator.cjs"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.js",
      "require": "./dist/postcss.cjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js",
      "require": "./dist/defaults.cjs"
    },
    "./framework": {
      "types": "./dist/framework.d.ts",
      "import": "./dist/framework.js",
      "require": "./dist/framework.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./reset": {
      "types": "./dist/reset.d.ts",
      "import": "./dist/reset.js",
      "require": "./dist/reset.cjs"
    },
    "./css-macro/postcss": {
      "types": "./dist/css-macro/postcss.d.ts",
      "import": "./dist/css-macro/postcss.js",
      "require": "./dist/css-macro/postcss.cjs"
    },
    "./css-macro": {
      "types": "./dist/css-macro.d.ts",
      "import": "./dist/css-macro.js",
      "require": "./dist/css-macro.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./postcss-html-transform": {
      "types": "./dist/postcss-html-transform.d.ts",
      "import": "./dist/postcss-html-transform.js",
      "require": "./dist/postcss-html-transform.cjs"
    },
    "./package.json": "./package.json",
    "./index.css": "./index.css",
    "./index": "./index.css",
    "./preflight.css": "./preflight.css",
    "./preflight": "./preflight.css",
    "./theme.css": "./theme.css",
    "./theme": "./theme.css",
    "./utilities.css": "./utilities.css",
    "./utilities": "./utilities.css",
    "./with-layer.css": "./with-layer.css",
    "./with-layer": "./with-layer.css",
    "./uni-app-x": "./uni-app-x.css",
    "./uni-app-x.css": "./uni-app-x.css",
    "./css": "./css/index.css",
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "index.css",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "css",
    "dist",
    "generator-placeholder.css",
    "index.css",
    "preflight.css",
    "theme.css",
    "uni-app-x.css",
    "utilities.css",
    "with-layer.css"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "paths": {
        "@/*": [
          "./src/*"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@mpxjs/webpack-plugin": ">=2.0.0 <3.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.2.0 || ^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@mpxjs/webpack-plugin": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@babel/types": "^8.0.5",
    "@vue/compiler-dom": "^3.5.41",
    "@weapp-core/escape": "~8.0.0",
    "@weapp-tailwindcss/engine": "0.1.1",
    "@weapp-tailwindcss/logger": "2.0.3",
    "@weapp-tailwindcss/postcss": "3.3.8",
    "@weapp-tailwindcss/reset": "0.1.4",
    "@weapp-tailwindcss/shared": "2.0.3",
    "@weapp-tailwindcss/source-scan": "0.1.1",
    "comment-json": "^5.0.0",
    "debug": "~4.4.3",
    "fast-glob": "^3.3.3",
    "htmlparser2": "^12.0.0",
    "local-pkg": "^1.2.1",
    "lru-cache": "11.5.3",
    "magic-string": "^1.4.2",
    "micromatch": "^4.0.8",
    "oxc-parser": "^0.151.0",
    "oxc-walker": "^1.1.1",
    "semver": "~7.8.5",
    "tailwindcss-config": "2.0.5",
    "weapp-style-injector": "1.0.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mpxjs/webpack-plugin": "^2.11.1",
    "tsx": "^4.23.15",
    "vite": "^7.3.6",
    "webpack": "5.105.4"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist --noEmit false && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts && tsx ../../tools/weapp-tailwindcss-scripts/src/create-entry-dts.ts && tsx ../../tools/weapp-tailwindcss-scripts/src/ensure-escape-dts.ts",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist --noEmit false && tsx ../../tools/weapp-tailwindcss-scripts/src/rewrite-dts-aliases.ts && tsx ../../tools/weapp-tailwindcss-scripts/src/create-entry-dts.ts",
    "build:tsc": "cross-env NODE_ENV=development tsc --build tsconfig.json",
    "build:css": "pnpm --filter @weapp-tailwindcss/scripts build:css",
    "build:weapp-theme": "pnpm --filter @weapp-tailwindcss/scripts build:weapp-theme",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:ui": "vitest --ui",
    "bench": "vitest bench --config ./vitest.config.ts --reporter=default --reporter=json --outputFile.json=benchmark/bench-report.json",
    "bench:core-compiler": "node --expose-gc --import tsx benchmark/core-compiler.ts",
    "bench:vite-perf": "pnpm --filter @weapp-tailwindcss/scripts bench:vite-perf",
    "bench:vite-perf:summary": "pnpm --filter @weapp-tailwindcss/scripts bench:vite-perf:summary",
    "bench:js-handlers": "pnpm --filter @weapp-tailwindcss/scripts bench:js-handlers",
    "bench:js-diff": "pnpm --filter @weapp-tailwindcss/scripts bench:js-diff",
    "tsd": "tsd",
    "clean": "pnpm --filter @weapp-tailwindcss/scripts clean:core",
    "get-decl": "pnpm --filter @weapp-tailwindcss/scripts get-decl",
    "ls:pack": "npm pack --dry-run",
    "colors": "pnpm --filter @weapp-tailwindcss/scripts colors",
    "release": "pnpm --filter @weapp-tailwindcss/scripts release",
    "lint": "eslint .",
    "lint:fix": "eslint ./src --fix",
    "bench:vite-dev-hmr": "pnpm --filter @weapp-tailwindcss/scripts bench:vite-dev-hmr",
    "watch-hmr:speed-report": "pnpm --filter @weapp-tailwindcss/scripts watch-hmr:speed-report",
    "test:watch-hmr": "pnpm --filter @weapp-tailwindcss/scripts test:watch-hmr"
  }
}