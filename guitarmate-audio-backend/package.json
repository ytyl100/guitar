{
  "name": "guitarmate-audio-backend",
  "private": true,
  "version": "1.0.0",
  "description": "GuitarMate Audio Backend based on NestJS 10 + Prisma 5 + SQLite",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "demo:audio": "node scripts/generate-demo-audio.mjs",
    "demo:original": "node scripts/generate-original-mix.mjs",
    "demo:solo": "node scripts/generate-solo-sample.mjs",
    "demo:pipeline": "node scripts/demo-audio-to-miniprogram.mjs",
    "demo:clean": "node scripts/cleanup-demo-artifacts.mjs",
    "verify:alignment": "node scripts/verify-alignment.mjs",
    "verify:package": "node scripts/verify-practice-package.mjs",
    "verify:meta": "node scripts/verify-score-metadata.mjs",
    "verify:pitch": "node scripts/verify-pitch-analysis.mjs",
    "tab:import": "tsx scripts/tab-import.ts",
    "tab:verify": "tsx scripts/tab-import.ts --verify",
    "tab:gpx-fixture": "node scripts/make-gpx-fixture.mjs",
    "transcribe:verify": "node scripts/e2e-transcription-pipeline.mjs",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ali-oss": "^6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}