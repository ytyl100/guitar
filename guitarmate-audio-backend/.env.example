# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQLite Database path
DATABASE_URL="file:./data/app.db"

# Server Port
PORT="3000"

# Aliyun OSS Configuration
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="guitar-practice"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

# ── URL 导入（yt-dlp）─────────────────────────────────────────────
# YouTube 现在必须带 cookies，否则固定返回「Sign in to confirm you're not a bot」。
# 三种配置方式，优先级从上到下；都不配时 URL 导入只支持直链音频（.mp3/.wav/.flac）：
#
# 1) 最推荐：把浏览器导出的 cookies.txt 放到后端根目录（会被自动识别，无需改此项）
#    YTDLP_COOKIES="cookies.txt"
# 2) 从浏览器直接读（Firefox 的 cookies 不加密，最可靠；
#    Chrome/Edge 127+ 因 App-Bound 加密通常会失败）
#    YTDLP_COOKIES_FROM_BROWSER="firefox"
# 3) 指定 yt-dlp 可执行文件（默认自动探测 PATH 上的 yt-dlp / python -m yt_dlp）
#    YTDLP_BIN="C:\\Users\\me\\AppData\\Local\\Python\\pythoncore-3.14-64\\Scripts\\yt-dlp.exe"
# 高级：透传给 yt-dlp 的额外参数（空格分隔），例如切换 player client
#    YTDLP_EXTRA_ARGS="--extractor-args youtube:player_client=web_safari"
# YouTube 现在**必须**有 JS 运行时才能解挑战（缺它时表现为 `Video unavailable`）：自动探测 node/deno/bun
#    YTDLP_JS_RUNTIME="node"
# 解 JS 挑战的求解器脚本（默认 ejs:github，从 GitHub 取）；无外网时设 off
#    YTDLP_REMOTE_COMPONENTS="ejs:github"
# 下载超时（毫秒，默认 900000 = 15 分钟）
#    YTDLP_TIMEOUT_MS="900000"
